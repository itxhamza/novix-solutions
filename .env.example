# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

# API key from https://resend.com (free tier is enough for a contact form).
RESEND_API_KEY=

# Where contact-form submissions are delivered. Never shown on the site.
CONTACT_TO_EMAIL=

# Sender. "onboarding@resend.dev" works immediately but only delivers to the
# address your Resend account was created with. After verifying
# novixsolutions.com in Resend, switch to e.g. "Novix Website <hello@novixsolutions.com>".
CONTACT_FROM_EMAIL="Novix Website <onboarding@resend.dev>"
