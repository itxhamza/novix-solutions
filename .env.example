# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
#
# Without RESEND_API_KEY, the contact form still works in development: each
# submission is printed to the terminal instead of emailed. In production a
# missing key makes the form return an error, so set it before going live.

# REQUIRED in production. API key from https://resend.com (free tier is enough).
RESEND_API_KEY=

# Optional. Where contact-form submissions are delivered.
# Defaults to the address shown on the site (info@novixsolutions.com).
CONTACT_TO_EMAIL=

# Optional sender. "onboarding@resend.dev" works immediately but only delivers
# to the address your Resend account was created with. After verifying
# novixsolutions.com in Resend, switch to e.g. "Novix Website <hello@novixsolutions.com>".
CONTACT_FROM_EMAIL="Novix Website <onboarding@resend.dev>"
